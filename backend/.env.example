# Required in production. Any long random string. Sessions are signed with it.
SECRET_KEY=change-me-to-64-random-characters
SESSION_DAYS=30

# Optional. Leave blank to run with in-memory storage.
MONGO_URI=
MONGO_DB=rescrolly

# Optional. Leave blank to disable "Continue with Auth0".
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Optional. Recipe import from links, photos, and text uses Gemini when set;
# without it a rule-based parser handles quantities. Free key at aistudio.google.com.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional. Reads cook steps aloud.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Name of the tunnel from `cloudflared tunnel create`.
CLOUDFLARE_TUNNEL=rescrolly
